---
layout: layouts/base.njk
---
{% from "icon.njk" import icon %}
<article class="post col-content" itemscope itemtype="http://schema.org/BlogPosting">
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": {{ title | dump | safe }},
        "datePublished": "{{ date | dateFormat('iso') }}",
        "author": {
            "@type": "Person",
            "name": "Carlos Asmat",
            "url": "{{ site.url }}"
        },
        "publisher": {
            "@type": "Person",
            "name": "Carlos Asmat"
        },
        "url": "{{ site.url }}{{ page.url }}"{% if tags | length %},
        "keywords": [{% for tag in tags %}{% if tag != "posts" and tag != "drafts" %}{{ tag | dump | safe }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]{% endif %}{% if categories | length %},
        "articleSection": {{ categories[0] | dump | safe }}{% endif %}
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
            { "@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ site.url }}/blog/" },
            { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ site.url }}{{ page.url }}" }
        ]
    }
    </script>
    <header class="post-header">
        <h1 class="post-title" itemprop="name headline">{{ title }}{% if "drafts" in tags %} <span class="post-status-badge post-status-draft">draft</span>{% elif status == "archive" %} <span class="post-status-badge post-status-archive">archive</span>{% endif %}</h1>
        <p class="post-meta">
            <time datetime="{{ date | dateFormat('iso') }}" itemprop="datePublished">
                {{ date | dateFormat('isodate') }}
            </time>
            <span class="post-meta-actions">
                {% for tag in tags %}{% if tag != "posts" and tag != "drafts" %}<a class="post-tag" href="/tags/?tag={{ tag }}">{{ tag }}</a>{% endif %}{% endfor %}
                <a class="post-sponsor" href="https://github.com/sponsors/Sotilrac" target="_blank" rel="noopener noreferrer" title="Sponsor on GitHub"><span class="icon">{{ icon("fa-heart") }}</span> Sponsor</a>
            </span>
        </p>
    </header>

    <div class="post-content" itemprop="articleBody">
        {{ content | safe }}
    </div>

    {% set slug = page.fileSlug | postSlug %}
    {% set postComments = comments[slug] %}
    {% if postComments %}
    <section class="post-comments">
        <h2>Comments from the original blog</h2>
        {% for c in postComments %}
        <div class="blog-comment">
            <div class="blog-comment-meta">
                <strong class="blog-comment-author">{{ c.author }}</strong>
                <time class="blog-comment-date">{{ c.date }}</time>
            </div>
            <div class="blog-comment-text">{{ c.text | nl2br | safe }}</div>
        </div>
        {% endfor %}
    </section>
    {% endif %}

    <hr class="comments-separator">
    <div class="giscus-comments">
        <script src="https://giscus.app/client.js"
            data-repo="Sotilrac/sotilrac.gitlab.io"
            data-repo-id="R_kgDOR-lK-g"
            data-category="Comments"
            data-category-id="DIC_kwDOR-lK-s4C6f0S"
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="bottom"
            data-theme="preferred_color_scheme"
            data-lang="en"
            data-loading="lazy"
            crossorigin="anonymous"
            async>
        </script>
    </div>

    {% set nav = collections.publicPosts | postNavigation(page.url) %}
    {% if nav.prev or nav.next %}
    <nav class="post-nav">
        {% if nav.prev %}<a class="post-nav-prev" href="{{ nav.prev.url }}">&larr; {{ nav.prev.data.title }}</a>{% endif %}
        {% if nav.next %}<a class="post-nav-next" href="{{ nav.next.url }}">{{ nav.next.data.title }} &rarr;</a>{% endif %}
    </nav>
    {% endif %}
</article>
