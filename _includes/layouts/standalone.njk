<!DOCTYPE html>
<html lang="en">
  {% include "head.njk" %}

  <body class="standalone" style="background: {{ calc.bg }}">
    <main class="standalone-wrap">{{ content | safe }}</main>

    <script>
      // When opened as a popup (the detach button), grow the window so the
      // rendered calculator never needs a scrollbar. No-op in a normal tab,
      // where resizeTo is ignored. The calc fills the window width and has
      // min-height 100vh, so only height matters: the custom element upgrades
      // asynchronously and its height changes when the user switches tabs, so
      // we watch with ResizeObserver and re-fit. Height is capped to the
      // screen so a tab taller than the display can't push the title bar
      // off-screen.
      (function () {
        var calc = document.querySelector(".standalone-wrap").firstElementChild;
        if (!calc) return;
        function fit() {
          var h = calc.scrollHeight;
          if (!h) return;
          var chromeY = window.outerHeight - window.innerHeight;
          var maxH = (screen.availHeight || window.outerHeight) - 40;
          var newH = Math.min(maxH, Math.ceil(h + chromeY));
          if (newH <= window.outerHeight) return;
          try {
            window.resizeTo(window.outerWidth, newH);
          } catch (e) {}
        }
        addEventListener("load", function () {
          requestAnimationFrame(fit);
        });
        if (typeof ResizeObserver !== "undefined") {
          new ResizeObserver(fit).observe(calc);
        }
      })();

      // Offline support for the installed app. Scope defaults to /calc/, which
      // covers every /calc/<name>/ page.
      if ("serviceWorker" in navigator) {
        addEventListener("load", function () {
          navigator.serviceWorker.register("/calc/sw.js").catch(function () {});
        });
      }

      // Umami: one event per page load identifying how the calc was opened.
      // mode = 'pwa' (installed), 'popup' (detach button from a post),
      // 'browser' (direct visit to /calc/<name>/). Fires after window load so
      // the deferred umami.js has had time to attach.
      addEventListener("load", function () {
        setTimeout(function () {
          if (!window.umami || !window.umami.track) return;
          var mode = "browser";
          if (
            window.matchMedia &&
            window.matchMedia("(display-mode: standalone)").matches
          ) {
            mode = "pwa";
          } else if (window.opener) {
            mode = "popup";
          }
          window.umami.track("calc-open", { calc: {{ calc.name | dump | safe }}, mode: mode });
        }, 0);
      });
    </script>
  </body>
</html>
