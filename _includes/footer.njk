<footer class="no-print">
  <p>
    &copy; 2006&ndash;{{ buildDate | dateFormat("year") }} Carlos Asmat. All rights reserved.
    <button type="button" class="contact-toggle" aria-expanded="false" aria-controls="contact-panel">Contact me</button>
    for inquiries.
  </p>
  <div id="contact-panel" class="contact-panel" inert>
    <div class="contact-inner">
      <form class="contact-form" data-key="{{ contact.key }}">
        <input name="name" type="text" placeholder="Name" aria-label="Name" autocomplete="name" maxlength="80" required>
        <input name="email" type="email" placeholder="Email" aria-label="Email" autocomplete="email" maxlength="254" pattern="[^@\s]+@[^@\s.]+(\.[^@\s.]+)+" title="An address like name@example.com" required>
        <select name="subject" aria-label="Subject" required>
          <option value="general">General inquiry</option>
          <option value="work">Hiring or consulting</option>
        </select>
        <textarea name="message" placeholder="Message" aria-label="Message" rows="5" maxlength="5000" required></textarea>
        {#- Web3Forms honeypot: hidden from people, ticked by bots. -#}
        <input class="contact-hp" name="botcheck" type="checkbox" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="contact-actions">
          <p class="contact-error" role="alert"></p>
          <button type="submit">Send</button>
        </div>
      </form>
      <p class="contact-sent" role="status" hidden>
        <svg aria-hidden="true" viewBox="0 0 52 52" width="3em" height="3em"><circle cx="26" cy="26" r="24" fill="none"/><path fill="none" d="M15 27l7 7 15-15"/></svg>
        Message sent
      </p>
    </div>
  </div>
</footer>

<!-- JS -->

<script src="{{ site.baseurl }}/js/lightbox.js" defer></script>
<script src="{{ site.baseurl }}/js/contact.js" defer></script>
<script>
(async function () {
  const key = new URLSearchParams(location.search).get("key");
  if (!key) return;
  const phoneEnc = {{ resume.phone | dump | safe }};
  const emailEnc = {{ resume.email | dump | safe }};
  try {
    const phone = await decryptField(phoneEnc, key);
    const email = await decryptField(emailEnc, key);
    setField("phone", "phoneContent", phone);
    setField("email", "emailContent", email);
  } catch (err) {
    alert("Ah ah ah. You didn't say the magic word.");
  }

  function setField(wrapId, contentId, value) {
    const wrap = document.getElementById(wrapId);
    const content = document.getElementById(contentId);
    if (content) content.textContent = value;
    if (wrap) wrap.classList.add("is-revealed");
  }

  async function decryptField(payload, password) {
    const data = Uint8Array.from(atob(payload), (c) => c.charCodeAt(0));
    const header = {{ contactCrypto.saltBytes }} + {{ contactCrypto.ivBytes }};
    if (data.length < header) throw new Error("payload too short");
    const salt = data.slice(0, {{ contactCrypto.saltBytes }});
    const iv = data.slice({{ contactCrypto.saltBytes }}, header);
    const ct = data.slice(header);
    const baseKey = await crypto.subtle.importKey(
      "raw",
      new TextEncoder().encode(password),
      "PBKDF2",
      false,
      ["deriveKey"],
    );
    const aesKey = await crypto.subtle.deriveKey(
      {
        name: "PBKDF2",
        salt,
        iterations: {{ contactCrypto.iterations }},
        hash: "{{ contactCrypto.hash }}",
      },
      baseKey,
      { name: "AES-GCM", length: {{ contactCrypto.keyBits }} },
      false,
      ["decrypt"],
    );
    const pt = await crypto.subtle.decrypt({ name: "AES-GCM", iv }, aesKey, ct);
    return new TextDecoder().decode(pt);
  }
})();
</script>
