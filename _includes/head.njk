{% set isPost = "posts" in (tags or []) %}
{% set pageTitle %}{% if title %}Carlos Asmat - {{ title }}{% else %}{{ site.title }}{% endif %}{% endset %}
{% set pageDescription %}{% if description %}{{ description | safe }}{% elif excerpt %}{{ excerpt | striptags | safe }}{% elif page.url == '/' or page.url == '/blog/' %}{{ resume.summary[0] | safe }}{% elif isPost and content %}{{ content | excerpt | safe }}{% else %}{{ site.description | safe }}{% endif %}{% endset %}
{% set pageImage = site.url + (image or "/img/carlos-asmat.jpg") %}
{% set ogType = "article" if isPost else "website" %}
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="color-scheme" content="light dark">

  <link rel="icon" href="{{ site.baseurl }}/img/favicon-64.png">
  {% if manifest %}
  <link rel="manifest" href="{{ manifest }}">
  <meta name="theme-color" content="{{ themeColor }}">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="{{ title }}">
  <link rel="apple-touch-icon" href="{{ site.baseurl }}/img/favicon-256.png">
  {% endif %}

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">

  <meta property="og:type" content="{{ ogType }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ pageImage }}">
  {% if ogType == "article" %}
  <meta property="article:author" content="Carlos Asmat">
  {% if date %}<meta property="article:published_time" content="{{ date | dateFormat('iso') }}">{% endif %}
  {% for category in (categories or []) %}<meta property="article:section" content="{{ category }}">
  {% endfor %}{% for tag in (tags or []) %}{% if tag != "posts" and tag != "drafts" %}<meta property="article:tag" content="{{ tag }}">
  {% endif %}{% endfor %}
  {% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ pageImage }}">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": {{ (resume.first_name + " " + resume.last_name) | dump | safe }},
    "url": "{{ site.url }}",
    "image": "{{ site.url }}{{ resume.picture }}",
    "description": {{ resume.summary[0] | dump | safe }},
    "jobTitle": {{ resume.experience[0].title | dump | safe }},
    "worksFor": { "@type": "Organization", "name": {{ resume.experience[0].company | dump | safe }} },
    "homeLocation": {
      "@type": "Place",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Boston",
        "addressRegion": "MA",
        "addressCountry": "US"
      }
    },
    "sameAs": [{% for link in resume.links %}{{ link.url | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
  }
  </script>

  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ site.title | dump | safe }},
    "url": "{{ site.url }}",
    "description": {{ site.description | dump | safe }},
    "inLanguage": "en",
    "publisher": { "@type": "Person", "name": "Carlos Asmat", "url": "{{ site.url }}" }
  }
  </script>
  {% endif %}

  <script defer src="{{ site.baseurl }}/js/vendor/umami.js" data-website-id="55179db8-c15f-4659-8430-1ef4e05d3ffb" data-host-url="https://cloud.umami.is"></script>
  <script defer src="{{ site.baseurl }}/js/edge-tracker.js"></script>
  <link rel="stylesheet" href="{{ site.baseurl }}/css/vendor/prism-coy.min.css">
  <link rel="stylesheet" href="{{ site.baseurl }}/css/vendor/prism-coy-dark.css" media="(prefers-color-scheme: dark)">
  <link rel="stylesheet" href="{{ site.baseurl }}/css/vendor/katex.min.css">
  <link rel="stylesheet" href="{{ site.baseurl }}/css/main.css">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ site.url }}{{ site.baseurl }}/feed.xml">
</head>
