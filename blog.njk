---
layout: layouts/page.njk
title: Blog
permalink: /blog/
hero: true
---

<div class="posts col-content">

  <p class="archive-blurb">Musings, projects, and learnings by a robotics engineer.</p>

  <ul class="cat-legend">
    <li><span class="cat-dot" data-cat="working theory"></span>Working Theory</li>
    <li><span class="cat-dot" data-cat="projects"></span>Projects</li>
    <li><span class="cat-dot" data-cat="robotics"></span>Robotics</li>
    <li><span class="cat-dot" data-cat="tools"></span>Tools</li>
    <li><span class="cat-dot" data-cat="software"></span>Software</li>
    <li><span class="cat-dot" data-cat="press"></span>Press</li>
    <li><span class="cat-dot" data-cat="news"></span>News</li>
    <li><span class="cat-dot" data-cat="til"></span>TIL</li>
  </ul>

  <div class="archive-grid">
    {% for year in [2026, 2023, 2022, 2021, 2019] %}
    <section class="archive-year">
      <h3>{{ year }}</h3>
      <ul class="post-list">
        {% for post in collections.publicPosts %}
          {% if post.date.getFullYear() == year %}
          <li>
            <span class="post-meta">{{ post.date | dateFormat("isodate") }}</span>
            {% if post.data.categories %}{% set rawcat = post.data.categories[0] | lower %}<span class="cat-dot" data-cat="{{ 'news' if rawcat == 'info' else rawcat }}"></span>{% endif %}
            <a class="post-link" href="{{ post.url }}">{{ post.data.title }}</a>
          </li>
          {% endif %}
        {% endfor %}
      </ul>
    </section>
    {% endfor %}
  </div>

  <section class="press-section" aria-labelledby="press-heading">
    <h2 id="press-heading" class="page-heading">In the Press</h2>
    <p class="archive-blurb">Interviews, articles, podcasts, and other mentions over the years. Click a card to expand.</p>
    <div class="press-carousel-wrap">
      <button class="press-scroll prev" type="button" aria-label="Scroll press cards left" hidden>&larr;</button>
      <ul class="press-carousel" tabindex="0" aria-label="Press mentions, scrollable">
        {% for entry in press | sort(true, false, 'date') %}{% if entry.status != "draft" %}
        <li class="press-card" data-kind="{{ entry.kind }}">
          <button class="press-card-toggle" type="button" aria-expanded="false">
            <span class="press-thumb{% if entry.thumb_mode == 'logo' %} is-logo{% endif %}">
              {% if entry.screenshot %}
              <img src="{{ entry.screenshot }}" alt="{{ entry.outlet }} thumbnail" loading="lazy" />
              {% else %}
              <span class="press-thumb-fallback">{{ entry.outlet }}</span>
              {% endif %}
              {% if entry.kind == "video" and entry.thumb_mode != "logo" %}<span class="press-play" aria-hidden="true">▶</span>{% endif %}
            </span>
            <span class="press-card-footer">
              <span class="press-outlet">{{ entry.outlet }}</span>
              <span class="press-date">{{ entry.date | dateFormat("isodate") }}</span>
            </span>
          </button>
          <div class="press-card-detail" hidden>
            <h3 class="press-title">{{ entry.title }}</h3>
            {% if entry.author %}<p class="press-author">by {{ entry.author }}</p>{% endif %}
            {% if entry.blurb %}<p class="press-blurb">{{ entry.blurb }}</p>{% endif %}
            <p class="press-actions">
              <a class="press-action-btn" href="{{ entry.url }}" target="_blank" rel="noopener">Visit ↗</a>
              {% if entry.archive %}{% wayback entry.archive, "Archive" %}{% endif %}
              {% if entry.post %}<a class="press-action-btn ghost" href="{{ entry.post }}">Blog post →</a>{% endif %}
            </p>
          </div>
        </li>
        {% endif %}{% endfor %}
      </ul>
      <button class="press-scroll next" type="button" aria-label="Scroll press cards right">&rarr;</button>
    </div>
  </section>

  <h2 class="page-heading archive-heading">Carlitos' Contraptions Archive</h2>
  <p class="archive-blurb">An earlier life of tinkering with robots, and questionable soldering.
  Dug out from the sands of WordPress at the old <em>carlitoscontraptions.com</em> domain.</p>

  <div class="archive-grid">
    {% for year in [2013, 2012, 2011, 2010, 2009, 2008, 2007, 2006] %}
    <section class="archive-year">
      <h3>{{ year }}</h3>
      <ul class="post-list">
        {% for post in collections.publicPosts %}
          {% if post.date.getFullYear() == year %}
          <li>
            <span class="post-meta">{{ post.date | dateFormat("isodate") }}</span>
            {% if post.data.categories %}{% set rawcat = post.data.categories[0] | lower %}<span class="cat-dot" data-cat="{{ 'news' if rawcat == 'info' else rawcat }}"></span>{% endif %}
            <a class="post-link" href="{{ post.url }}">{{ post.data.title }}</a>
          </li>
          {% endif %}
        {% endfor %}
      </ul>
    </section>
    {% endfor %}
  </div>

  {% if collections.publicPosts.length == 0 %}
  <p>Blog posts are being migrated. Check back soon.</p>
  {% endif %}
</div>

<script>
(function () {
  var legend = document.querySelector(".cat-legend");
  if (!legend) return;
  var items = legend.querySelectorAll("li");
  var posts = document.querySelectorAll(".post-list li");
  var active = null;

  function filterCat(cat) {
    if (!cat || active === cat) {
      active = null;
      legend.classList.remove("filtering");
      items.forEach(function (i) { i.classList.remove("active"); });
      posts.forEach(function (p) { p.style.display = ""; });
      history.replaceState(null, "", "/blog/");
    } else {
      active = cat;
      legend.classList.add("filtering");
      items.forEach(function (i) { i.classList.remove("active"); });
      items.forEach(function (li) {
        var d = li.querySelector(".cat-dot");
        if (d && d.getAttribute("data-cat") === cat) li.classList.add("active");
      });
      posts.forEach(function (p) {
        var pDot = p.querySelector(".cat-dot");
        var pCat = pDot ? pDot.getAttribute("data-cat") : null;
        p.style.display = pCat === cat ? "" : "none";
      });
      history.replaceState(null, "", "/blog/?cat=" + encodeURIComponent(cat));
    }
  }

  items.forEach(function (li) {
    li.addEventListener("click", function () {
      var dot = li.querySelector(".cat-dot");
      var cat = dot ? dot.getAttribute("data-cat") : null;
      filterCat(cat);
    });
  });

  var param = new URLSearchParams(window.location.search).get("cat");
  if (param) filterCat(param.toLowerCase());
})();

(function () {
  var carousel = document.querySelector(".press-carousel");
  if (!carousel) return;
  var wrap = carousel.parentElement;
  var prev = wrap.querySelector(".press-scroll.prev");
  var next = wrap.querySelector(".press-scroll.next");
  var cards = carousel.querySelectorAll(".press-card");

  cards.forEach(function (card) {
    var toggle = card.querySelector(".press-card-toggle");
    var detail = card.querySelector(".press-card-detail");
    if (!toggle || !detail) return;
    toggle.addEventListener("click", function () {
      var isOpen = card.classList.contains("is-open");
      cards.forEach(function (c) {
        c.classList.remove("is-open");
        var t = c.querySelector(".press-card-toggle");
        var d = c.querySelector(".press-card-detail");
        if (t) t.setAttribute("aria-expanded", "false");
        if (d) d.hidden = true;
      });
      if (!isOpen) {
        card.classList.add("is-open");
        toggle.setAttribute("aria-expanded", "true");
        detail.hidden = false;
        card.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
      }
    });
  });

  function updateArrows() {
    var max = carousel.scrollWidth - carousel.clientWidth;
    if (prev) prev.hidden = carousel.scrollLeft <= 4;
    if (next) next.hidden = carousel.scrollLeft >= max - 4;
  }
  function scrollBy(dir) {
    var step = Math.max(240, carousel.clientWidth * 0.7);
    carousel.scrollBy({ left: dir * step, behavior: "smooth" });
  }
  if (prev) prev.addEventListener("click", function () { scrollBy(-1); });
  if (next) next.addEventListener("click", function () { scrollBy(1); });
  carousel.addEventListener("scroll", updateArrows, { passive: true });
  window.addEventListener("resize", updateArrows);
  updateArrows();
})();
</script>
