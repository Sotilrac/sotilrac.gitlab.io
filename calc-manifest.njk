---
pagination:
  data: calcList
  size: 1
  alias: calc
permalink: "/calc/{{ calc.name }}/manifest.webmanifest"
eleventyExcludeFromCollections: true
---
{
  "id": "/calc/{{ calc.name }}/",
  "name": "{{ calc.title }}",
  "short_name": "{{ calc.title }}",
  "start_url": "/calc/{{ calc.name }}/",
  "scope": "/calc/{{ calc.name }}/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "{{ calc.bg }}",
  "theme_color": "{{ calc.theme }}",
  "icons": [
    { "src": "/img/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/img/favicon-256.png", "sizes": "256x256", "type": "image/png" },
    {
      "src": "/img/favicon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
