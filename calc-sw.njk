// Offline support for the installable /calc/<name>/ apps.
// Stale-while-revalidate: serve from cache instantly, refresh in the
// background so the next launch picks up a new deploy.
// CACHE is rebuilt with each Eleventy run (buildId is set at build time),
// so a deploy gets its own cache and the activate handler evicts any old
// calc-* cache from a previous deploy.
const CACHE = "calc-{{ buildId }}";

{% raw %}self.addEventListener("install", () => self.skipWaiting());
self.addEventListener("activate", (e) =>
  e.waitUntil(
    Promise.all([
      self.clients.claim(),
      caches.keys().then((keys) =>
        Promise.all(
          keys
            .filter((k) => k.startsWith("calc-") && k !== CACHE)
            .map((k) => caches.delete(k)),
        ),
      ),
    ]),
  ),
);

self.addEventListener("fetch", (e) => {
  const req = e.request;
  if (req.method !== "GET") return;
  e.respondWith(
    caches.open(CACHE).then((cache) =>
      cache.match(req).then((hit) => {
        const net = fetch(req)
          .then((res) => {
            if (res.ok && new URL(req.url).origin === location.origin) {
              cache.put(req, res.clone());
            }
            return res;
          })
          .catch(() => hit);
        return hit || net;
      }),
    ),
  );
});
{% endraw %}
